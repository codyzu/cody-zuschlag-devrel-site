---
import {getCollection} from 'astro:content';
import Article from './Article.astro';
import {sortArticles} from './articles/sort-articles';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';

const articles = sortArticles(await getCollection('articles'));
---

<Section id="articles" labelledby="articles-heading">
  <SectionTitle
    id="articles-heading"
    title="Articles and blog posts"
    subtitle="A curated list of written content"
  />
  <ul role="list">
    {articles.map((article) => (
      <Article article={article.data} />
    ))}
  </ul>
</Section>
