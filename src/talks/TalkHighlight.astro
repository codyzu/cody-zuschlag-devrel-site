---
import type {CollectionEntry} from 'astro:content';
import Link from '../Link.astro';
import {formatDate} from '../format-date';

interface Props {
  talk: CollectionEntry<'talks'>['data'];
}
const {talk} = Astro.props;
---

<li class="flex min-w-0 flex-col gap-4 rounded-lg border border-secondary/40 p-6">
  <h4 class="text-2xl font-bold text-primary leading-tight">{talk.name}</h4>
  <p class="text-secondary">
    {talk.conference} ·{' '}
    <time datetime={talk.date}>{formatDate(talk.date)}</time>
  </p>
  <p class="text-secondary">{talk.description}</p>
  <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2">
    {talk.video && talk.video !== 'none' && (
      <Link icon="i-lucide-video text-lg" url={talk.video}>
        Watch now
      </Link>
    )}
    {talk.slides && (
      <Link icon="i-lucide-monitor text-lg" url={talk.slides}>
        Slides
      </Link>
    )}
    {talk.repo && (
      <Link icon="i-lucide-github text-lg" url={talk.repo}>
        GitHub repo
      </Link>
    )}
  </div>
</li>
