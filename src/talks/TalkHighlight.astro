---
import type {CollectionEntry} from 'astro:content';
import {Picture} from 'astro:assets';
import Link from '../Link.astro';
import {formatTalkDate} from './format-talk-date';
import TalkRecording from './TalkRecording.astro';

interface Props {
  talk: CollectionEntry<'talks'>['data'];
  now: number;
}
const {talk, now} = Astro.props;
---

<li class="flex min-w-0 flex-col rounded-lg border border-secondary/40">
  {talk.thumbnail && (
    <Picture
      src={talk.thumbnail}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={[320, 480, 640, 960, 1200]}
      width={1200}
      height={675}
      fit="contain"
      sizes="(min-width: 80rem) 369px, (min-width: 64rem) calc((100vw - 174px) / 3), (min-width: 40rem) calc(100vw - 122px), calc(100vw - 58px)"
      alt={talk.thumbnailAlt!}
      loading="lazy"
      decoding="async"
      class="w-full h-auto rounded-t-lg object-contain"
      pictureAttributes={{class: 'block aspect-video'}}
    />
  )}
  <div class="flex flex-1 flex-col gap-4 p-6">
    <h4 class="text-2xl font-bold text-primary leading-tight">{talk.name}</h4>
    <p class="text-secondary">
      {talk.conference} ·{' '}
      <time datetime={talk.date}>{formatTalkDate(talk.date, now)}</time>
    </p>
    <p class="text-secondary">{talk.description}</p>
    <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2">
      <TalkRecording talk={talk} />
      {talk.slides && (
        <Link icon="i-lucide-monitor text-lg" url={talk.slides}>
          Slides
        </Link>
      )}
      {talk.repo && (
        <Link icon="i-lucide-github text-lg" url={talk.repo}>
          GitHub repo
        </Link>
      )}
    </div>
  </div>
</li>
