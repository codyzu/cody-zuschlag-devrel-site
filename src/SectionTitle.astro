---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}
const {title, subtitle, id} = Astro.props;
---

<div class="flex flex-col gap-2">
  <h2
    id={id}
    class="self-start font-bold text-3xl sm:text-5xl bg-clip-text text-transparent leading-tight bg-gradient-title"
  >
    {title}
  </h2>
  {subtitle && <p class="text-secondary text-xl">{subtitle}</p>}
</div>
