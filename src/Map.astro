---
import {getCollection} from 'astro:content';
import {speakingLocations} from './map/speaking-locations.ts';

const entries = await getCollection('talks');
const locations = speakingLocations(entries.map(({data}) => data));
const totalCount = locations.reduce((total, city) => total + city.count, 0);
---

<div id="speaking-map-wrapper">
  <p class="text-secondary mb-4">
    {totalCount} in-person speaking engagements across {locations.length}{' '}
    cities. Virtual events aren’t shown.
  </p>
  <div
    id="speaking-map"
    class="w-full h-[300px] md:h-[450px] rounded-xl isolate bg-mapSurface"
    role="region"
    aria-label="Speaking locations map"
    aria-describedby="map-help"
    hidden
  ></div>
  <p id="map-help" class="text-secondary text-sm mt-3" hidden>
    Green dots mark speaking locations; the white house marks home in Annecy.
    Select a marker for its city and engagement count. Use the zoom buttons to
    explore nearby cities.
  </p>
  <details class="mt-4 text-secondary">
    <summary class="cursor-pointer text-highlight">
      Speaking cities and counts
    </summary>
    <ul role="list" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2 mt-3">
      {locations.map(({location, count, coordinates}) => (
        <li
          data-map-city
          data-location={location}
          data-latitude={coordinates[0]}
          data-longitude={coordinates[1]}
          data-count={count}
        >
          {location} · {count} {count === 1 ? 'engagement' : 'engagements'}
        </li>
      ))}
    </ul>
  </details>
  <p class="mt-3 text-secondary text-sm">
    <a
      href="https://www.openstreetmap.org/?mlat=45.916&mlon=6.133#map=8/45.916/6.133"
      class="link"
    >
      View Annecy on OpenStreetMap
    </a>
    · ©{' '}
    <a href="https://www.openstreetmap.org/copyright" class="link">
      OpenStreetMap contributors
    </a>
  </p>
</div>
<script>
  import {observeSpeakingMap} from './map/observe-speaking-map.ts';

  observeSpeakingMap();
</script>
