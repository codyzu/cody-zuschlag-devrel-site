<div
  id="annecy-map"
  class="w-full h-[315px]"
  role="region"
  aria-label="Map showing Annecy, France"
>
  <a
    href="https://www.openstreetmap.org/?mlat=45.916&mlon=6.133#map=8/45.916/6.133"
    class="link"
  >
    View Annecy on OpenStreetMap
  </a>
</div>
<script>
  // Transitional native MapLibre initialization; phase 2 replaces this with a lazy iframe.
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import './map.css';
  const container = document.getElementById('annecy-map');
  if (container) {
    const map = new maplibregl.Map({
      container,
      center: [6.133, 45.916],
      zoom: 8,
      style:
        'https://api.maptiler.com/maps/basic/style.json?key=qlckteTnKEl9ZBax9Thw',
    });
    new maplibregl.Marker().setLngLat([6.133, 45.916]).addTo(map);
  }
</script>
