---
import {Picture} from 'astro:assets';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
import {gallery} from './gallery/gallery';

// Section padding, gaps, and the main's 80rem maximum determine the image slots.
const regularSizes =
  '(min-width: 80rem) 278px, (min-width: 64rem) calc((100vw - 168px) / 4), (min-width: 40rem) calc((100vw - 136px) / 2), calc(100vw - 56px)';
const featuredSizes =
  '(min-width: 80rem) 572px, (min-width: 64rem) calc((100vw - 136px) / 2), (min-width: 40rem) calc(100vw - 120px), calc(100vw - 56px)';
---

<Section id="photos" labelledby="photos-heading">
  <SectionTitle
    id="photos-heading"
    title="Photo gallery"
    subtitle="Small collection of presentation highlights"
  />
  <div class="gallery grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {gallery.map((photo) => (
      <Picture
        src={photo.image}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        widths={
          photo.featured
            ? [320, 640, 960, 1280, 1600]
            : [320, 480, 640, 960, 1280]
        }
        width={photo.featured ? 1600 : 1280}
        height={
          photo.aspectRatio === '3/4' ? 1707 : photo.featured ? 1200 : 960
        }
        fit="cover"
        sizes={photo.featured ? featuredSizes : regularSizes}
        alt={photo.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-full rounded-xl object-cover"
        pictureAttributes={{
          class: `block min-w-0 ${photo.aspectRatio === '3/4' ? 'portrait aspect-[3/4]' : 'aspect-[4/3]'}${photo.featured ? ' featured' : ''}`,
        }}
      />
    ))}
  </div>
</Section>
<style>
  .gallery {
    container-type: inline-size;
    --gallery-gap: calc(var(--spacing) * 4);
  }
  @media (min-width: 40rem) {
    /* A 4:3 landscape slot is three quarters of one gallery column. */
    .gallery > picture {
      --landscape-height: calc((100cqw - var(--gallery-gap)) * 3 / 8);
    }
    .featured,
    .portrait {
      aspect-ratio: auto;
      height: calc(var(--landscape-height) * 2 + var(--gallery-gap));
    }
    .featured {
      grid-column: span 2;
      grid-row: span 2;
    }
    .portrait {
      grid-row: span 2;
    }
  }
  @media (min-width: 64rem) {
    .gallery > picture {
      --landscape-height: calc((100cqw - var(--gallery-gap) * 3) * 3 / 16);
    }
  }
  @supports (display: grid-lanes) {
    .gallery {
      display: grid-lanes;
    }
    .featured,
    .portrait {
      grid-row: auto;
    }
  }
</style>
