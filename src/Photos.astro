---
import type {ImageMetadata} from 'astro';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
// Temporary original images; responsive Picture output and the manifest belong to phase 3.
const images = import.meta.glob<{default: ImageMetadata}>('./gallery/*.jpeg', {
  eager: true,
});
const descriptions: Record<string, string> = {
  '01': 'Cody presenting the technology stack at React Summit',
  '02': 'Cody speaking on stage at React Summit',
  '03': 'Cody presenting at NodeConf EU',
  '04': 'Cody presenting a community-first slide at NodeConf EU',
  '05': 'Cody introducing his talk at DevFest Alps',
  '06': 'Cody presenting a slide about unicorns at React Summit',
  '07': 'Cody explaining the motivation for his talk at DevFest Alps',
  '08': 'Cody’s presentation title slide at React Summit',
};
---

<Section id="photos" labelledby="photos-heading">
  <SectionTitle
    id="photos-heading"
    title="Photo gallery"
    subtitle="Small collection of presentation highlights"
  />
  <div class="gallery grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {Object.entries(images)
      .toSorted(([a], [b]) => a.localeCompare(b))
      .map(([path, {default: image}]) => (
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={descriptions[path.split('/').pop()!.slice(0, 2)]}
          loading="lazy"
          decoding="async"
          class:list={[
            'w-full h-full rounded-xl object-cover',
            path.includes('_portrait') ? 'aspect-[3/4]' : 'aspect-[4/3]',
            {
              featured: path.includes('_big'),
              portrait: path.includes('_portrait'),
            },
          ]}
        />
      ))}
  </div>
</Section>
<style>
  @media (min-width: 40rem) {
    .featured {
      grid-column: span 2;
      grid-row: span 2;
    }
    .portrait {
      grid-row: span 2;
    }
  }
</style>
